# ---------------------------------------------------------------------------
# docker-compose environment. Copy to .env at the repo root:  cp .env.example .env
#
# This file configures the CONTAINER stack. backend/.env is still what a
# non-Docker `npm run dev` reads — the two are independent.
# ---------------------------------------------------------------------------

# Required — compose refuses to start without these.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
WEBHOOK_SECRET=

# MySQL (the compose-managed instance)
DB_PASSWORD=trace
DB_NAME=trace_db
# Only for a managed database OUTSIDE the compose network. The in-cluster
# MySQL is reached over the private network and needs no TLS.
DB_SSL=false

# Origin of the deployed frontend, e.g. https://project-trace.vercel.app
# Doubles as the CORS allowlist and the base of password-reset links.
# Blank = development (any origin reflected).
FRONTEND_URL=

# Reverse-proxy hop count for Express's `trust proxy`. 1 behind Caddy.
# Leave 0 if nothing proxies the backend, or clients can spoof their IP and
# evade the login rate limiter.
TRUST_PROXY=1

# HTTPS (only for `--profile tls` on the deployed VM). Caddy needs a real
# hostname — a bare IP cannot be issued a certificate. A free DuckDNS
# subdomain works. ACME_EMAIL is where Let's Encrypt sends expiry warnings.
API_DOMAIN=
ACME_EMAIL=

# Only for the optional `local-frontend` profile (single-box deployment).
# Blank = same origin, which is right when nginx also proxies /api.
VITE_API_URL=

# Notifications — both optional; unconfigured channels are skipped with a
# stated reason rather than failing at send time.
UNISMS_SECRET_KEY=
UNISMS_SENDER_ID=TRACE
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
