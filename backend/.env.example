# Copy to .env and fill in real values. Never commit .env.

# ── Database (MySQL) ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trace_db

# ── Server ────────────────────────────────────────────────
PORT=3000
# REQUIRED — the server refuses to start without it. This signs every auth
# token, so anyone who knows it can forge a login for any account, including
# admins. Never reuse the old 'trace-jwt-secret-change-in-production' value:
# it is public in this repo's git history.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Microservices ─────────────────────────────────────────
# Flask AI engine (EasyOCR / Prophet / Random Forest)
AI_ENGINE_URL=http://127.0.0.1:5005
# n8n routing orchestrator
N8N_URL=http://localhost:5678

# ── SMS notifications (UniSMS) ────────────────────────────
UNISMS_SECRET_KEY=
UNISMS_SENDER_ID=TRACE
# Fallback recipient used when a student has no phone number on file
TEST_PHONE_NUMBER=

# ── Email notifications (Nodemailer / SMTP) ───────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
