# Full reference — what every variable does, where each credential comes from, and how
# to verify it:  docs/ENV_SETUP_GUIDE.md
# Copy to .env and fill in real values. Never commit .env.

# ── Database (MySQL) ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trace_db
# TLS for the database. Managed MySQL (Aiven, TiDB, RDS, …) generally requires
# it and will refuse a plaintext connection outright. Leave false for a local
# MySQL, which has no certificate.
DB_SSL=false
# Only when the provider issues its own CA rather than using a public one:
# paste the PEM itself, not a file path.
DB_SSL_CA=
# Per-instance connection pool ceiling. N replicas each open this many, so keep
# it under the managed database's connection cap.
DB_POOL_LIMIT=10

# ── Server ────────────────────────────────────────────────
PORT=3300
# REQUIRED — the server refuses to start without it. This signs every auth
# token, so anyone who knows it can forge a login for any account, including
# admins. Never reuse the old 'trace-jwt-secret-change-in-production' value:
# it is public in this repo's git history.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# REQUIRED — shared secret for machine-to-machine callers (the n8n router
# calling /api/documents/assign, and payment webhooks). These endpoints have no
# user session, so this is the only thing standing between them and the public.
# Generate with the same command as JWT_SECRET.
# NOTE: the n8n HTTP Request node must send it as header `x-webhook-secret`.
WEBHOOK_SECRET=

# ── Microservices ─────────────────────────────────────────
# Flask AI engine (EasyOCR / Prophet / Random Forest)
# Flask defaults to 5005. Do NOT use 5000 — macOS Control Center
# (AirPlay Receiver) already listens there.
# Origin of the React app. Used as the CORS allowlist for both the REST API and
# the Socket.IO handshake, and as the base of the password-reset link emailed to
# users. Leave blank in development: origins are reflected, which is what the
# Vite dev proxy needs. A deployment MUST set this. Comma-separate to allow more
# than one (e.g. staging + production).
FRONTEND_URL=

# Number of reverse proxies in front of this server, for Express's `trust proxy`.
# 0 = direct (correct locally). Set to 1 behind Caddy/nginx/a load balancer, or
# every request carries the proxy's IP and the IP-keyed rate limiters collapse
# into a single shared bucket. Deliberately a hop count and not `true`: blindly
# trusting X-Forwarded-For would let a client spoof its address and walk past
# the login limiter.
TRUST_PROXY=0

AI_ENGINE_URL=http://127.0.0.1:5005
# n8n routing orchestrator
N8N_URL=http://localhost:5678

# ── SMS notifications (UniSMS) ────────────────────────────
UNISMS_SECRET_KEY=
UNISMS_SENDER_ID=TRACE
# Fallback recipient used when a student has no phone number on file
TEST_PHONE_NUMBER=

# ── Email notifications (Nodemailer / SMTP) ───────────────
# Leave blank to disable email alerts — the server reports the channel as
# "not configured" at startup and skips sending, rather than failing per-send.
# For Gmail you must use an App Password, not the account password.
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: the From address, if it differs from SMTP_USER
SMTP_FROM=
