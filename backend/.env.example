# Copy to .env and fill in real values. Never commit .env.

# ── Database (MySQL) ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trace_db

# ── Server ────────────────────────────────────────────────
PORT=3300
# REQUIRED — the server refuses to start without it. This signs every auth
# token, so anyone who knows it can forge a login for any account, including
# admins. Never reuse the old 'trace-jwt-secret-change-in-production' value:
# it is public in this repo's git history.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# REQUIRED — shared secret for machine-to-machine callers (the n8n router
# calling /api/documents/assign, and payment webhooks). These endpoints have no
# user session, so this is the only thing standing between them and the public.
# Generate with the same command as JWT_SECRET.
# NOTE: the n8n HTTP Request node must send it as header `x-webhook-secret`.
WEBHOOK_SECRET=

# ── Microservices ─────────────────────────────────────────
# Flask AI engine (EasyOCR / Prophet / Random Forest)
# Flask defaults to 5005. Do NOT use 5000 — macOS Control Center
# (AirPlay Receiver) already listens there.
AI_ENGINE_URL=http://127.0.0.1:5005
# n8n routing orchestrator
N8N_URL=http://localhost:5678

# ── SMS notifications (UniSMS) ────────────────────────────
UNISMS_SECRET_KEY=
UNISMS_SENDER_ID=TRACE
# Fallback recipient used when a student has no phone number on file
TEST_PHONE_NUMBER=

# ── Email notifications (Nodemailer / SMTP) ───────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
